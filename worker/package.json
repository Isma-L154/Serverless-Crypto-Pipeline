{
  "name": "crypto-pipeline-worker",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "types": "wrangler types",
    "migrate": "wrangler d1 migrations apply crypto-pipeline-prod-prices --remote",
    "migrate:local": "wrangler d1 migrations apply crypto-pipeline-prod-prices --local",
    "typecheck": "wrangler types && tsc --noEmit",
    "test": "wrangler types && vitest run"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "^1.4.4",
    "typescript": "^7.0.2",
    "vitest": "^5.0.4",
    "wrangler": "^4.151.1"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "workerd@1.20261012.1": true
  }
}
